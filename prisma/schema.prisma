generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon -pooler host): app traffic at runtime.
  url       = env("DATABASE_URL")
  // Direct connection: Prisma CLI (migrate/db push/introspect). Migrations over
  // a transaction-mode pooler fail with "prepared statement already exists".
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Project {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  summary     String
  description String
  role        String?
  tags        String[]
  githubUrl   String?
  demoUrl     String?
  featured    Boolean        @default(false)
  published   Boolean        @default(false)
  images      ProjectImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProjectImage {
  id        String  @id @default(cuid())
  url       String
  alt       String
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  body        String
  tags        String[]
  published   Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
