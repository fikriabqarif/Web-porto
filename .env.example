# Postgres (Neon in prod, local Postgres for development)
DATABASE_URL=postgresql://user:password@localhost:5432/webporto?schema=public

# `openssl rand -base64 32`
AUTH_SECRET=replace-me

# Single admin account
ADMIN_EMAIL=owner@example.com
# Generate with: npm run hash-password
# Escape every `$` as `\$`: .env parsing treats `$2b` as an undefined variable
# and would silently strip the hash. In production, set this via the host env.
ADMIN_PASSWORD_HASH=\$2b\$12\$......................................................

# Admin lives at this path instead of the obvious /admin. Pick something random.
# Baked in at build time: change it, then rebuild.
ADMIN_SECRET_PATH=/kelola-REPLACE-ME

# Vercel Blob (optional locally -> files fall back to public/uploads)
BLOB_READ_WRITE_TOKEN=

# Optional: send an email copy of contact messages
RESEND_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: set to 1 when the host's libvips/sharp crashes on /_next/image
# (old x86 CPUs without SSE4.2). Leave unset on Vercel.
NEXT_IMAGE_UNOPTIMIZED=
