{
  "name": "web-porto",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "verify": "tsx --tsconfig scripts/tsconfig.verify.json scripts/verify-core.tsx"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vercel/blob": "2.8.2",
    "bcryptjs": "3.0.3",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "resend": "6.37.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
